    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitest/coverage-v8": "4.1.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "expect-type": "^1.3.0",
    "fast-check": "^4.8.0",
