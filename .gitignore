# Build artifacts
dist/

# Dependencies
#
# NO TRAILING SLASH, AND THAT IS THE WHOLE POINT (#585). A pattern ending in "/" matches
# DIRECTORIES ONLY. A symlink named node_modules -- which is how a shared install gets reused
# across worktrees -- is a FILE to git regardless of what it points at, so `node_modules/` did
# not cover it and `git add -A` staged a 131-byte symlink with no warning. pnpm then cannot
# mkdir over it and EVERY job dies at "Install dependencies" with ENOTDIR, which reads as a
# runner outage rather than a repo defect.
#
# Without the slash this still ignores the directory and now also the symlink.
# scripts/assert-no-install-blocking-paths.mjs names anything that gets through anyway.
node_modules

# Turborepo cache
.turbo/

# Test coverage
coverage/

# Next.js build output
.next/
out/

# env files (contain secrets). Broad match, then re-admit the committed
# *.example templates — those are documentation and carry no real values.
.env*
!.env.example
!.env.*.example

# Private keys / certificates
*.pem
*.key
!**/public*.key

# SOPS + age — only *.sops.* ciphertext is ever committed. Never commit
# plaintext secrets or age PRIVATE keys.
*.agekey
keys.txt
*age*key*.txt
vault.yml
*.plain.*

# Cloud / CI credential drops
.vercel
*.pfx
*.p12
credentials.json
service-account*.json


# Stryker mutation testing artifacts
.stryker-tmp/
reports/mutation/
# (root-anchored rule above misses nested packages — match at any depth)
**/reports/mutation/

# TypeScript incremental build info
*.tsbuildinfo

# Playwright artifacts
test-results/
playwright-report/

# Framework dev/build output
**/.svelte-kit/
apps/remix-example/build/
**/vite.config.ts.timestamp-*.mjs

# Git worktrees scratch
.worktrees/

# nForma agent scratch (local, per-session)
**/nf-session-seen-*.flag
.planning/memory/
packages/*/.planning/

# repowise auto-generated cache (regenerated per session, ~1.6k-line churn)
.planning/repowise/cochange-cache.json

# Playwright MCP browser tools write screenshots/artifacts to the repo root
# (their allowed roots are the repo only, so they cannot target a scratchpad).
.playwright-mcp/

# Python bytecode. Generated by `python3 -m py_compile` during local
# verification; four of these were staged before this rule existed.
__pycache__/
*.py[cod]

# next-env.d.ts is GENERATED — `next build` and `next dev` rewrite it, and the
# file's own header says "This file should not be edited". Tracking it meant
# every build left a phantom diff nobody made, so every branch looked dirty:
#
#   M apps/open-swe/next-env.d.ts
#
# That is the condition under which someone reaches for `git checkout .` or
# `stash`, and it has already cost one bad git operation on this project.
#
# It is also VERSION-SPECIFIC: under Next 15.5 line 3 is
# `/// <reference path="./.next/types/routes.d.ts" />` while Next 16 writes
# `import "./.next/dev/types/routes.d.ts";` — so the tracked content was pinned
# to whichever Next last built, and the cross-version matrix rewrote it on every
# run.
#
# Both apps' tsconfigs still `include` it; Next regenerates it before it is
# needed. VERIFIED that typechecking with the file absent produces 0 errors,
# identical to with it present, so untracking costs nothing.
next-env.d.ts

# Local dev server logs from `pnpm dev` (scripts/dev-all.sh)
.dev-logs/

# Written by scripts/run-checks.mjs; the pairing gate reads it. Per-run, never committed.
.checks-run.json

# Written by scripts/eject-audit-run.mjs INTO each audit worktree, so that a later run can
# see a kept tree by reading the tree itself (#1031). It has to be ignored rather than moved:
# unignored it is an UNTRACKED FILE in the tree, and the EJECTED half's preparation refuses on
# untracked files — "they are invisible to the classifier and would be swept" — so the marker
# added to make kept trees visible was making every audit refuse before it measured anything.
#
# Not hypothetical, and not rare: NO eject-audit succeeded between #1036 merging and this
# line. The last good census was measured at 97aa3a6d (2026-09-07 20:27:26); #1036 merged at
# 20:39:43, twelve minutes later, and 97aa3a6d is a descendant of neither of its shas. Two
# sessions hit it independently, each leaving a pair of trees whose FULL half has node_modules
# and whose EJECTED half does not — the fingerprint of refusing at the eject step, before the
# install.
#
# IGNORED RATHER THAN RELOCATED, deliberately. The marker is meant to live in the tree, because
# that is how `keptTreePaths` recognises one; moving it would mean changing the reader too, and
# an ignored file is not an untracked one, so it never reaches the check that was refusing.
.eject-audit-inflight

# Python plane, local only. CI pip-installs into the runner directly, so nothing
# here has ever needed a venv convention — but developing apps/*-backend locally
# requires one, and an unignored .venv is 40k untracked files one `git add -A` away
# from a commit.
apps/*-backend/.venv/
