{
  "name": "@deepagents-nextjs/edge",
  "version": "0.1.0",
  "private": true,
  "description": "DeepAgents edge runtime handlers for Deno Deploy and Cloudflare Workers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "validate": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@vitest/coverage-v8": "^4.1.6",
    "publint": "^0.3.21",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
