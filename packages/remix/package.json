{
  "name": "@deepagents-nextjs/remix",
  "version": "0.1.0",
  "private": false,
  "description": "DeepAgents Remix server handler and React hook",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "validate": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@remix-run/node": ">=2.0.0",
    "@remix-run/react": ">=2.0.0",
    "react": ">=18.0.0",
    "typescript": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "publint": "^0.3.21",
    "react": "^19.2.6",
    "react-dom": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
