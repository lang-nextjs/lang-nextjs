{
  "name": "@deepagents-nextjs/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "DeepAgents Next.js test utilities — mock backend server for consumer test suites",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "validate": "publint && attw --pack ."
  },
  "peerDependencies": {
    "ai": ">=6.0.154",
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "ai": "^6.0.197",
    "next": "^16.2.7",
    "publint": "^0.3.21",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
