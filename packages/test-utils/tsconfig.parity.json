{
  // The cross-package accumulator parity suite is NOT part of test-utils'
  // own source graph — it deliberately reaches into four sibling packages to
  // compare their copies of SseFrameAccumulator. It therefore cannot live
  // under the package tsconfig's `rootDir: "./src"` (TS6059), and widening
  // that rootDir would change the published dist/ layout.
  //
  // Giving it its own no-emit program keeps the suite fully typechecked while
  // leaving the package's build config untouched.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": ["src/accumulator-parity.test.ts"]
}
