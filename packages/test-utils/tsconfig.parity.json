{
  // The cross-package suites are NOT part of test-utils' own source graph —
  // they deliberately reach into sibling packages: accumulator-parity compares
  // four copies of SseFrameAccumulator, and approval-frame-conformance drives
  // packages/server's approval gate through `ai`'s own chunk schema (which
  // packages/server has no dependency on, and should not grow one to hold a
  // test). Neither can live under the package tsconfig's `rootDir: "./src"`
  // (TS6059), and widening that rootDir would change the published dist/
  // layout.
  //
  // Giving them their own no-emit program keeps both fully typechecked while
  // leaving the package's build config untouched.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": [
    "src/accumulator-parity.test.ts",
    "src/approval-frame-conformance.test.ts"
  ]
}
