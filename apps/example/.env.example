# ──────────────────────────────────────────────
# DeepAgents Example App — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
#
# Both backends are in this repo. Start them with:
#   cd apps/django-backend  && docker compose up -d
#   cd apps/fastapi-backend && docker compose up -d
#
# The UI toggle switches between them at runtime.
# ──────────────────────────────────────────────

# ── Django Backend (port 8002, no auth) ───────

DJANGO_URL=http://localhost:8002/api/chat/stream/
DJANGO_AUTH_TOKEN=

# ── FastAPI Backend (port 8001, no auth) ──────

FASTAPI_URL=http://localhost:8001/api/chat/stream
FASTAPI_AUTH_TOKEN=

# ── Node Backend (port 8003, no auth) ─────────
#
# The TypeScript plane (apps/node-backend). Serving three rungs since #7/#9/#10;
# unreachable from any UI until #360 made the runtime axis a three-value choice.
# Unset means the runtime is LISTED AND DISABLED in the selector, with this
# variable named in its title — absent, not hidden, because setting one line
# here is the remedy and hiding the option hides it.
NODE_URL=http://localhost:8003/api/chat/stream
NODE_AUTH_TOKEN=

# ── Feature Flags ─────────────────────────────

# Enable stream reconnection (resume interrupted SSE streams).
# ENABLE_STREAM_RECONNECT=true
