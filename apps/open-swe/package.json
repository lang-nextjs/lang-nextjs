{
  "name": "open-swe",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack --port ${PORT:-3001}",
    "dev:local": "bash agent/dev-local.sh",
    "agent": "node agent/server.mjs --port ${AGENT_PORT:-8100}",
    "start": "next start --port ${PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "palette": "node ../../scripts/check-palette.mjs .",
    "test": "pnpm palette && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deepagents-nextjs/react": "workspace:*",
    "@deepagents-nextjs/rungs": "workspace:*",
    "@deepagents-nextjs/server": "workspace:*",
    "@deepagents-nextjs/ui": "workspace:*",
    "@vitest/coverage-v8": "^4.1.11",
    "lucide-react": "^1.34.0",
    "next": "^16.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
