# LangGraph Platform server URL (e.g. http://localhost:8000 when running locally)
LANGGRAPH_PLATFORM_URL=http://localhost:8000

# open-swe assistant or graph identifier in the Platform
OPEN_SWE_ASSISTANT_ID=open-swe

# LangGraph Platform API key (if required; empty string for local dev without auth)
LANGGRAPH_API_KEY=

# ── Docker sandbox (workspace execution) ──────────────────────────────────
# The sandbox at /api/open-swe/sandbox/* runs agent tool calls in ephemeral
# Docker containers. All vars below are optional — defaults shown.
#
# Recommended workspace image: build it from apps/open-swe/sandbox/Dockerfile
#   docker build -t open-swe-sandbox:latest apps/open-swe/sandbox
# then set SANDBOX_IMAGE below. Unset, it falls back to public node:22-alpine.
# SANDBOX_IMAGE=node:22-alpine
# SANDBOX_MAX_WORKSPACES=8
# SANDBOX_MEMORY_MB=512
# SANDBOX_CPUS=1
# SANDBOX_EXEC_TIMEOUT_MS=30000

# ── Blazing sandbox provider (ADAPT-06) — NOT IMPLEMENTED YET ──────────────
# The Blazing-backed sandbox provider is not built yet. The real Blazing API
# contract is being defined in Borduas-Holdings/blazing#48:
#   https://github.com/Borduas-Holdings/blazing/issues/48
# Until that lands, setting BLAZING_API_URL makes getSandbox() THROW — by
# design, so a non-working provider is never silently selected. Leave these
# unset; the Docker provider above is the only working sandbox today.
# BLAZING_API_URL=
# BLAZING_API_KEY=
