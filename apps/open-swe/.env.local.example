# LangGraph Platform server URL.
#
# You do NOT need to set this to run rung 4. `pnpm --filter open-swe dev:local`
# starts the bundled local agent backend (apps/open-swe/agent/) on :8100 and
# points this at it automatically. See docs/LOCAL-AGENT.md.
#
# Set it only to target a LangGraph deployment of your own. Note :8000 is
# avoided as a default because rung 5's DynamoDB Local binds it.
LANGGRAPH_PLATFORM_URL=http://localhost:8100

# open-swe assistant or graph identifier in the Platform
OPEN_SWE_ASSISTANT_ID=open-swe

# LangGraph Platform API key (if required; empty string for local dev without auth)
LANGGRAPH_API_KEY=

# ── Docker sandbox (workspace execution) ──────────────────────────────────
# The sandbox at /api/open-swe/sandbox/* runs agent tool calls in ephemeral
# Docker containers. All vars below are optional — defaults shown.
#
# Recommended workspace image: build it from apps/open-swe/sandbox/Dockerfile
#   docker build -t open-swe-sandbox:latest apps/open-swe/sandbox
# then set SANDBOX_IMAGE below. Unset, it falls back to public node:22-alpine.
# SANDBOX_IMAGE=node:22-alpine
# SANDBOX_MAX_WORKSPACES=8
# SANDBOX_MEMORY_MB=512
# SANDBOX_CPUS=1
# SANDBOX_EXEC_TIMEOUT_MS=30000

# ── Blazing sandbox provider (ADAPT-06) — NOT IMPLEMENTED YET ──────────────
# The Blazing-backed sandbox provider IS built (v1.7). Setting BLAZING_API_URL
# makes getSandbox() return a BlazingSandbox instead of the Docker one — it does
# not throw (lib/sandbox/index.ts:57-67). The contract landed in
# Borduas-Holdings/blazing#81 (issue #48, both closed).
#
# Note the var is BLAZING_API_TOKEN, not BLAZING_API_KEY. The adapter reads
# TOKEN; an API_KEY here does nothing.
#
# !! Nothing serves this API today. blazing's /v1/workspace* routes are
# !! deployment-dead: no deployment mounts a docker socket, blazing/workspace is
# !! built by no pipeline, and blazing HEAD states the repo has no stable public
# !! host. Pointing at a URL that 500s buys you nothing.
#
# !! SECURITY — do NOT point this at a shared/multi-tenant blazing. Its
# !! workspace API has a cross-tenant IDOR: Redis keys carry no tenant
# !! component, so any valid token enumerates, execs into, and destroys EVERY
# !! tenant's workspaces. Local, single-tenant instances only until that is
# !! fixed upstream. See apps/open-swe/docs/blazing-provider.md.
# BLAZING_API_URL=
# BLAZING_API_TOKEN=

# Auth for /api/open-swe/sandbox/* — the routes that run shell commands.
# Set     -> requests must send `Authorization: Bearer <token>`.
# Unset   -> open in dev (so `pnpm dev` and the E2E suite work), and 404 in
#            production. Unconfigured production serves nothing rather than an
#            unauthenticated shell.
# Set this for any deployment that is not your laptop.
# OPEN_SWE_SANDBOX_TOKEN=
