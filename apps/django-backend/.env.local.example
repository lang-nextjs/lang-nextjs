# Copy to .env.local and fill in values
# Use either OPENROUTER_API_KEY (recommended for local dev — free tier available)
# or ANTHROPIC_API_KEY for direct Anthropic access.
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional: override the model. Default is openai/gpt-4o-mini (cheap, reliable tool-calling).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
DJANGO_SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deepagents
REDIS_URL=redis://localhost:6379/0
BACKEND_URL=http://localhost:8002/api/chat/stream/

# Counter API the increment/get_counter tools call (host's Next.js example app).
# COUNTER_URL=http://host.docker.internal:3000/api/counter

# LangSmith tracing (optional but recommended for debugging agent runs).
# Sign up at https://smith.langchain.com — free tier covers 5K traces/month.
# When LANGSMITH_TRACING=true, langchain + langgraph auto-emit traces to LangSmith
# with no code changes required. Each chat turn becomes a clickable trace tree.
# Set LANGSMITH_ENDPOINT only if your account is in the EU region.
# LANGSMITH_API_KEY=<paste-your-lsv2-key-here>  # format: lsv2_pt_<32hex>_<10hex>
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=deepagents-nextjs
